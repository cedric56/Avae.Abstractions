<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Example.Maui.Views.FormView">
    <Grid ColumnDefinitions="Auto,*">

            <VerticalStackLayout
		   Spacing="5"
		   Margin="5" >

                <CollectionView Margin="5"
				ItemsSource="{Binding Pages}"
				SelectedItem="{Binding SelectedPage}"
			>
                    <!--<CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
							Spacing="10"
							Orientation="Horizontal">
                                <i:Icon Value="{Binding Icon}"/>
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>-->
                </CollectionView>
            </VerticalStackLayout>

        <Grid RowDefinitions="Auto, *, Auto" Grid.Column="1">
            <Label Grid.Row="0" Text="{Binding Title}" Grid.Column="1"/>
            <HorizontalStackLayout Grid.Row="0"  Grid.Column="1" >
                <Button Text="Back" Command="{Binding BackCommand}" />
                <Button Text="Forward" Command="{Binding ForwardCommand}" />
                <Button Text="X" Command="{Binding CloseCommand}" />
            </HorizontalStackLayout>

            <ContentView Content="{Binding ContextFor}" Padding="15" Grid.Row="1" />
            <HorizontalStackLayout Grid.Row="2" >
                <Button Text="Validate" Command="{Binding ValidateCommand}" />
                <Button Text="Cancel" Command="{Binding CloseCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>