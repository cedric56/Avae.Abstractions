<!-- build/Avae.Essentials.targets -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <AvaeHostIsMaui Condition="'$(UseMaui)' == 'true'">true</AvaeHostIsMaui>
    <AvaeHostIsMaui Condition="'$(AvaeHostIsMaui)' == ''">false</AvaeHostIsMaui>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMauiProject)' == 'true'">
    <DefineConstants>$(DefineConstants);IsMauiProject</DefineConstants>
  </PropertyGroup>

  <Target Name="AvaeReportHostFramework" BeforeTargets="Build">
    <Message Importance="high" Text="[Avae.Essentials] Host project IsMaui = $(AvaeHostIsMaui)" />
  </Target>

</Project>