@using Avae.Abstractions
@using MudBlazor
@inherits Avae.Razor.PageBase

<style>
    /* Split the screen in half */
    .split {
        height: 100%;
        position: fixed;
        z-index: 1;
        top: 0;
        overflow-x: hidden;
        padding-top: 20px;
    }

    .left {
        left: 0;
        width: 30%;
    }

    /* Right side - 70% */
    .right {
        right: 0;
        width: 70%;
    }

    /* If you want the content centered horizontally and vertically */
    .centered {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%; 
        height: 85%
    }

    .centered-grid {
        display: grid;
        place-items: center; /* Centre horizontalement ET verticalement */
        height: 85%;
        width: 100%;
        padding: 20px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .dynamic-grid {
        display: grid;
        width: 90%;
        height: 100%;
        max-height: 100%;
        overflow: auto;
    }

        .dynamic-grid > * {
            min-height: 0;
            width: 100%;
            height: 100%;
        }
</style>


<div class="split left" >
    <div class="centered">
        <MudList T="Avae.Abstractions.PageViewModelBase"
                 @bind-SelectedValue="@ViewModel.SelectedPage">
            @foreach (var page in ViewModel.Pages)
            {
                var name = page.DisplayName;
                <MudListItem Text="@name" Value="page" />
            }
        </MudList>
    </div>
</div>
<div class="split right">
        <MudOverlay Visible="@IsBusy" DarkBackground="true" Absolute="true" ZIndex="9999">
            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
        </MudOverlay>
    <div class="centered">                
        @ChildContent
        <div class="dynamic-grid">
            @if (CurrentView != null)
            {
                <DynamicComponent Type="@CurrentView.Type"
                                  Parameters="@CurrentView.Parameters" />
            }
            @Buttons
        </div>       
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Buttons { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public required PagesViewModelBase ViewModel { get; set; }

    private ComponentView CurrentView => (ComponentView)ViewModel.CurrentPage;
}
