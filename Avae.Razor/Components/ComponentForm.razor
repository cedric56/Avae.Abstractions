@using Avae.Abstractions
@using MudBlazor
@inherits Avae.Razor.Components.ComponentPage

<div class="grid">
    <MudOverlay Visible="@IsBusy" DarkBackground="true" Absolute="true" ZIndex="9999">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    </MudOverlay>
    <div>
        <MudList T="Avae.Abstractions.PageViewModelBase"
                 @bind-SelectedValue="@ViewModel.SelectedPage">
            @foreach (var page in ViewModel.Pages)
            {
                var name = page.DisplayName;
                <MudListItem Text="@name" Value="page" />
            }
        </MudList>
    </div>
        
    <div class="form">
        <div>
            @ChildContent
        </div>
        <div class="@Class">
            @if(CurrentView != null)
            {
                <DynamicComponent Type="@CurrentView.Type"
                                Parameters="@CurrentView.Parameters" />
            }
        </div>
        <div>
            @Buttons
        </div>
    </div>
</div>
@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Buttons { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private string? Class
    {
        get
        {
            return true == CurrentView?.IsCenter ? "center" : null;
        }
    }

    [Parameter]
    public required PagesViewModelBase ViewModel { get; set; }

    private ComponentView? CurrentView => ViewModel.ContextFor as ComponentView;

    private bool isDone = false;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if(!isDone)
        {
            isDone = true;
            ViewModel.ContextForChanged += OnContextForChanged;
        }
    }

    private async void OnContextForChanged(object? sender, IContextFor page)
    {
        await InvokeAsync(StateHasChanged);
    }
}
