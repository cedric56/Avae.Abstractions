@using Avae.Abstractions
@using Avae.Razor.Components
@using Avae.Services
@using MudBlazor
@inherits LayoutComponentBase
@* @implements IDisposable *@
@inject IIocConfiguration Configuration
@inject ComponentView NavMenu

<style>
    .form {
        display: grid;
        grid-template-rows: auto 1fr auto;
        padding: 2px
    }

    .grid {
        display: grid;
        grid-template-columns: auto 1fr;
        height: 93vh;
    }

    .center {
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>

@* Required *@
<MudThemeProvider IsDarkMode="IocConfiguration.IsDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider BackdropClick="false" />
@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        @Title
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <DynamicComponent Type="@NavMenu.Type" />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@* <div class="page">
   
    <div class="sidebar">
        <DynamicComponent Type="@NavMenu.Type"/>
    </div>

    <main>
        <article class="content px-4">             
            @Body
        </article>
    </main>
</div>
 *@
@code
{
    public string Title { get; set; } = "Application";

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private IocConfiguration IocConfiguration => ((IocConfiguration)Configuration);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        IocConfiguration.RequestedThemeChanged += ThemeChanged;
    }

    void ThemeChanged(object? sender, RequestedTheme theme)
    {
        InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        IocConfiguration.RequestedThemeChanged -= ThemeChanged;
    }
} 