<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-ios;net11.0-windows;net11.0-android;net11.0-macos</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsWindowsTarget>$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsTarget>    
    <IsAndroidTarget>$(TargetFramework.Contains('-android'))</IsAndroidTarget>
    <IsIosTarget>$(TargetFramework.Contains('-ios'))</IsIosTarget>
    <IsMacTarget>$([System.String]::Copy('$(TargetFramework)').Contains('-macos'))</IsMacTarget>
    <!--<PackageId>Avae.Essentials</PackageId>-->
  </PropertyGroup>
  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="'$(IsAndroidTarget)' == 'true'">24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Conditionally define the symbols -->
  <PropertyGroup>
    <DefineConstants Condition="'$(IsWindowsTarget)' == 'true'">$(DefineConstants);WINDOWS_OS</DefineConstants>
    <DefineConstants Condition="'$(IsWebProject)' == 'true'">$(DefineConstants);BROWSER</DefineConstants>
  </PropertyGroup>
  

  <PropertyGroup Condition="'$(IsWebProject)' == 'true'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Start clean -->
  <ItemGroup>
    <Compile Remove="**\*.browser.cs" />
    <Compile Remove="**\*.windows.cs" />
    <Compile Remove="**\*.desktop.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindowsTarget)' == 'true' AND '$(IsWebProject)' != 'true' AND '$(IsMacTarget)' != 'true' AND '$(IsIosTarget)' != 'true'">
    <PackageReference Include="WindowsContracts.Net.Foundation.UniversalApiContract" Version="5.19041.10" />
    <Compile Include="**\*.windows.cs" />
    <Compile Include="**\*.desktop.cs" />
  </ItemGroup>

  <!-- Browser / Web -->
  <ItemGroup Condition="'$(IsWebProject)' == 'true'">
    <Compile Include="**\*.browser.cs" />
  </ItemGroup>

  <!-- macOS -->
  <ItemGroup Condition="'$(IsMacTarget)' == 'true'">    
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.12.26368.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.Maui.Essentials" Version="11.0.0-preview.6.26198.1455" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="11.0.0-preview.6.26360.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>
  
</Project>