@using MudBlazor
@inherits LayoutComponentBase

<div class="page">
    @* Required *@
    <MudThemeProvider />
    <MudPopoverProvider />

    @* Needed for dialogs *@
    <MudDialogProvider />
    @* Needed for snackbars *@
    <MudSnackbarProvider />
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
           
            @Body
        </article>
    </main>
</div>
