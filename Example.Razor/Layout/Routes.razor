@using System.Diagnostics
@using Avae.DAL
@using Example.DAL
@using Example.Models
@using Microsoft.AspNetCore.Components.Routing
@inject IServiceProvider provider;
@inject IDBMonitor<Person> monitor;
@implements IAsyncDisposable
<Router AppAssembly="typeof(Example.Razor.Components.Home).Assembly"
AdditionalAssemblies="new[] { typeof(Avae.Razor.Layout.MainLayout).Assembly }"
        NotFoundPage="typeof(Avae.Razor.Components.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Avae.Razor.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code
{
    Func<Task>? unsuscribe;

    public static Func<Task>? Execute { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender && OperatingSystem.IsBrowser())
        {
            Debug.WriteLine($"IsBrowser = {OperatingSystem.IsBrowser()}");
            Debug.WriteLine($"Runtime = {System.Runtime.InteropServices.RuntimeInformation.OSDescription}");
            if (Execute != null)
                await Execute.Invoke();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        //unsuscribe = await provider.AddStreamingHub(monitor);
        unsuscribe = await provider.AddSignalR(monitor);
    }

    public async ValueTask DisposeAsync()
    {
        if (unsuscribe != null)
            await unsuscribe();
    }
}

