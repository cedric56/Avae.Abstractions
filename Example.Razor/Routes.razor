@using Microsoft.AspNetCore.Components.Routing
<Router AppAssembly="typeof(Example.Razor.Home).Assembly"
        AdditionalAssemblies="new[] { typeof(Avae.Razor.MainLayout).Assembly }"
        NotFoundPage="typeof(Avae.Razor.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Avae.Razor.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

