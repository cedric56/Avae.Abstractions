@using Example.ViewModels
@using MudBlazor
<Avae.Razor.FormBase ViewModel="@ViewModel" IsBusy="@ViewModel.IsBusy">
    <ChildContent>
        <MudGrid Class="align-items-center" Style="width: 100%;">
            <MudItem xs="12" sm="4">
                <!-- Espace vide pour équilibrer -->
            </MudItem>

            <MudItem xs="12" sm="4" Class="d-flex justify-center">
                <MudText Typo="Typo.h6">
                    @ViewModel.Title
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="4" Class="d-flex justify-end">
                <MudButton OnClick="@ViewModel.GoBack">Back</MudButton>
                <MudButton OnClick="@ViewModel.GoForward">Forward</MudButton>
                <MudButton OnClick="Close">X</MudButton>
            </MudItem>
        </MudGrid>
    </ChildContent>
    <Buttons>
        <MudStack>
            <MudButton OnClick="@ViewModel.Validate">Validate</MudButton>
            <MudButton OnClick="Close">Cancel</MudButton>
        </MudStack>
    </Buttons>
</Avae.Razor.FormBase>

@code
{
    [Parameter]
    public required FormViewModel ViewModel { get; set; }

    private async Task Close()
    {
        if (await ViewModel.CanClose())
            await ViewModel.Close(null);
    }
}