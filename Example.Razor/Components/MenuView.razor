@using System.ComponentModel
@using Avae.DAL
@using Avae.Razor.Components
@using Example.Models
@using Example.ViewModels
@using MudBlazor
@inherits ComponentPage
@page "/menu"
@inject MenuViewModel ViewModel

@if (CurrentView != null)
{
    <DynamicComponent Type="@CurrentView.Type" Parameters="@CurrentView.Parameters"/>
}
else
{
    <MudButton OnClick="ViewModel.Add">Add</MudButton>
    <MudButton OnClick="ViewModel.Update" Disabled="@IsEnabled">Update</MudButton>
    <MudButton OnClick="ViewModel.Remove" Disabled="@IsEnabled">Remove</MudButton>

    <MudList T="Person" 
        @bind-SelectedValue="@ViewModel.SelectedPerson"
        SelectionMode="SelectionMode.SingleSelection" >
        @foreach (var p in ViewModel.Persons)
        {
            <MudListItem Text="@p.FullName" Value="@p" />
        }
    </MudList>
}

@code {

    static bool isDone { get; set; } = false;

    private bool IsEnabled => ViewModel.SelectedPerson == null;

    private ComponentView? CurrentView => ViewModel.CurrentPage as ComponentView;


    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!isDone)
        {
            isDone = true;
            ViewModel.PropertyChanged -= PropertyChanged;
            ViewModel.PropertyChanged += PropertyChanged;
            try
            {
                ViewModel.Persons = new(await DBBase.Instance.GetAllAsync<Person>());
            }
            catch(Exception ex)
            {
                ViewModel.Persons = new();
            }
        }
    }

    async void PropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }
}