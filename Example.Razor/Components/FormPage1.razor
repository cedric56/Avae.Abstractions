@using Example.Models
@using Example.ViewModels
@using MudBlazor

<EditForm Model="@ViewModel.Person">
    <DataAnnotationsValidator />
    <MudTextField label="First name" 
                  aria-required="true"
                  @bind-Value="@ViewModel.Person.FirstName"
                  For="@(() => @ViewModel.Person.FirstName)" />
    <MudTextField label="Last name" 
                  aria-required="true"
                  For="@(() => @ViewModel.Person.LastName)"
                  @bind-Value="@ViewModel.Person.LastName" />
</EditForm>

<MudList T="Example.Models.Person"
    @bind-SelectedValues="SelectedPersons"
    SelectionMode="SelectionMode.MultiSelection">
    @foreach(var c in ViewModel.Persons)
    {
        <MudListItem Value="c" Text="@c.FirstName" />
    }
</MudList>

@code {
    [Parameter]
    public required FormViewModel ViewModel { get; set; }    

    public IReadOnlyCollection<Person> SelectedPersons
    {
        get => ViewModel.SelectedItems;
        set => ViewModel.SelectedItems = new(value);
    }
}
