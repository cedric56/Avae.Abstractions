<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="build\**" PackagePath="buildtransitive\" />
    <Compile Remove="PostgreSQL\**" />
    <TfmSpecificPackageFile Include="PostgreSQL\**">
      <PackagePath>lib\$(TargetFramework)\PostgreSQL\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>

    <Compile Remove="Sqlite\**" />
    <TfmSpecificPackageFile Include="Sqlite\**">
      <PackagePath>lib\$(TargetFramework)\Sqlite\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>

    <Compile Remove="SqlDependency\**" />
    <TfmSpecificPackageFile Include="SqlDependency\**">
      <PackagePath>lib\$(TargetFramework)\SqlDependency\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>

    <Compile Remove="SignalR\**" />
    <TfmSpecificPackageFile Include="SignalR\**">
      <PackagePath>lib\$(TargetFramework)\SignalR\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>

    <Compile Remove="MagicOnion\**" />
    <TfmSpecificPackageFile Include="MagicOnion\**">
      <PackagePath>lib\$(TargetFramework)\MagicOnion\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>

    <Compile Remove="MagicOnionClient\**" />
    <TfmSpecificPackageFile Include="MagicOnionClient\**">
      <PackagePath>lib\$(TargetFramework)\MagicOnionClient\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Dapper.Contrib" />
  </ItemGroup>

</Project>
