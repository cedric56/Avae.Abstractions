<ResourceDictionary x:Class="Avae.Maui.Themes.ErrorStyles"
                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Avae.Maui.Themes">
    <Style TargetType="Entry">
        <Setter Property="local:Validation.Enabled" Value="True" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="local:Validation.Enabled" Value="True" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="local:Validation.Enabled" Value="True" />
    </Style>
</ResourceDictionary>