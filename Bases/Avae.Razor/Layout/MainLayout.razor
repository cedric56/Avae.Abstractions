@using Avae.Core
@using Avae.Razor.Components
@using Avae.Razor.Services
@using Avae.Services
@using Avae.ViewModels
@using MudBlazor
@inherits LayoutComponentBase
@* @implements IDisposable *@
@inject IRequestedThemeService themeService
@inject RenderFragment fragment
@inject IIocConfiguration Configuration
@inject IServiceProvider ServiceProvider
@inject ComponentView NavMenu

@fragment
@* Required *@
<MudThemeProvider IsDarkMode="Service.IsDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider BackdropClick="false" />
@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        @Title
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <DynamicComponent Type="@NavMenu.Type" />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code
{
    public string Title { get; set; } = "Application";

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private RequestThemeService Service => ((RequestThemeService)themeService);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        CircuitServiceAccessor.Provider = ServiceProvider;

        Service.RequestedThemeChanged += ThemeChanged;
    }

    async void ThemeChanged(object? sender, RequestedTheme theme)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Service.RequestedThemeChanged -= ThemeChanged;
    }
} 