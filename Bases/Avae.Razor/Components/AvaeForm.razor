@using Avae.Razor
@using Avae.ViewModels
@using MudBlazor
@implements IDisposable
<div class="split">
    <MudOverlay Visible="@IsBusy" DarkBackground="true" Absolute="true" ZIndex="9999">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    </MudOverlay>

    <nav class="split-nav">
        <MudList T="NavigableView" @bind-SelectedValue="@ViewModel.SelectedNavigable">
            @foreach (var page in ViewModel.Navigables)
            {
                var name = page.DisplayName;
                <MudListItem Text="@name" Value="page" />
            }
        </MudList>
    </nav>

    <div class="form">
        <div class="form-header">@ChildContent</div>

        <div class="form-body">
            @if (ViewModel.CurrentView is ViewFor viewFor)
            {
                <DynamicComponent Type="@viewFor.Type" Parameters="@viewFor.Parameters" />
            }
        </div>

        <div class="form-footer">@Buttons</div>
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Buttons { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public required NavigableViewModelBase ViewModel { get; set; }

    private bool isDone = false;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if(!isDone)
        {
            isDone = true;
            ViewModel.CurrentViewChanged += OnViewChanged;
        }
    }

    protected async override Task OnInitializedAsync()
    {
        await Task.Run(async () =>
        {
            while (ViewModel.CurrentView == null)
            {
                await Task.Delay(100);
            }
        });
        await InvokeAsync(StateHasChanged);
    }

    private async void OnViewChanged(object? sender, IViewFor? view)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.CurrentViewChanged -= OnViewChanged;
    }
}
