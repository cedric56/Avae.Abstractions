@using Avae.Razor
@using Avae.Services
@using Avae.ViewModels
@using MudBlazor
@inherits LayoutComponentBase
@* @implements IDisposable *@
@inject IRequestedThemeService themeService
@inject IManagerReload reload
@inject IMvvmManager mvvmmanager
@inject NavigationManager manager

@* Required *@
<MudThemeProvider IsDarkMode="Service.IsDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider BackdropClick="false" />
@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        @Title
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <MudNavMenu>
            @foreach (var item in mvvmmanager.Navigables)
            {
                <MudNavLink OnClick="@(async () => await OnNavClick(item))">
                    @item.DisplayName
                </MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @if(mvvmmanager.CurrentView is ViewFor viewFor)
        {
            <DynamicComponent              
                Type="@viewFor.Type" 
                Parameters="@viewFor.Parameters"
                />
        }
    </MudMainContent>
</MudLayout>

@code
{
    public string Title { get; set; } = "Application";

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task OnNavClick(NavigableView item)
    {
        await mvvmmanager.OnNavigableChanged(item);        
        manager.NavigateTo(item.Href, reload.Reload);
        await InvokeAsync(StateHasChanged);
    }

    private RequestThemeService Service => ((RequestThemeService)themeService);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Service.RequestedThemeChanged += ThemeChanged;
    }

    async void ThemeChanged(object? sender, RequestedTheme theme)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Service.RequestedThemeChanged -= ThemeChanged;
    }
} 