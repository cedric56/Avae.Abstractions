@using System.Windows.Input
@using Avae.Razor
@using Avae.Services
@using MudBlazor
@inject IRequestedThemeService themeService
<MudDialog Class="@($"wui-dialog {(Service.IsDarkMode ? "mud-theme-dark" : "")}")" >
    <TitleContent>
        @if (!string.IsNullOrWhiteSpace(Parameters.Title))
        {
            <MudText Typo="Typo.h6">@Parameters.Title</MudText>
        }
        
    </TitleContent>

    <DialogContent>
        @if (ComponentView != null)
        {
            <DynamicComponent Type="@ComponentView.Type" Parameters="@ComponentView.Parameters" />
        }
    </DialogContent>

    <DialogActions>
        @* Order matters: WinUI's default/secondary action sits on the LEFT,
           the accented primary action on the RIGHT *@
        @if (!string.IsNullOrWhiteSpace(Parameters.PrimaryButtonText))
        {
            <MudButton class="dialog-action"
                    disabled="@Parameters.IsPrimaryButtonEnabled"
                       OnClick="Primary">
                @Parameters.PrimaryButtonText
            </MudButton>
        }
        @if (!string.IsNullOrWhiteSpace(Parameters.SecondaryButtonText))
        {
            <MudButton class="dialog-action"
                    disabled="@Parameters.IsSecondaryButtonEnabled"
                       OnClick="Secondary">
                @Parameters.SecondaryButtonText
            </MudButton>
        }
        @if (!string.IsNullOrWhiteSpace(Parameters.CloseButtonText))
        {
            <MudButton class="dialog-action" OnClick="Close">@Parameters.CloseButtonText</MudButton>
        }
    </DialogActions>
</MudDialog>
@code {
    private RequestThemeService Service => ((RequestThemeService)themeService);

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
            Parameters.Opening?.Invoke();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Parameters.Opened?.Invoke();
    }

    [CascadingParameter]
    public required IMudDialogInstance Instance{ get; set; }

    [Parameter]
    public required ContentDialogParams Parameters{ get; set; }

    private ViewFor? ComponentView => Parameters.Content as ViewFor;

    private string Style(string? text)
    {
        var style = string.IsNullOrWhiteSpace(text) ? "none" : "block";
        return $@"display:{style}";
    }

    private void Close()
    {        
        SetResult(ContentDialogResult.None,
            Parameters.CloseButtonCommand,
            Parameters.CloseButtonCommandParameter,
            Parameters.CloseButtonClick);
    }

    private void Primary()
    {
        SetResult(ContentDialogResult.Primary,
            Parameters.PrimaryButtonCommand,
            Parameters.PrimaryButtonCommandParameter,
            Parameters.PrimaryButtonClick);
    }

    private void Secondary()
    {
        SetResult(ContentDialogResult.Secondary,
            Parameters.SecondaryButtonCommand,
            Parameters.SecondaryButtonCommandParameter,
            Parameters.SecondaryButtonClick);
    }

    private void SetResult(ContentDialogResult result, ICommand? command = null, object? parameter = null, Action? click = null)
    {
        if (true == Parameters.Closing?.Invoke(result.ToString()))
            return;

        if (command != null)
        {
            if (true == command.CanExecute(parameter))
                command.Execute(parameter);
        }
        else if (click != null)
        {
            click?.Invoke();
        }
        else
        {
            Instance.Close(result);
        }

        Parameters.Closed?.Invoke();
    }
}
