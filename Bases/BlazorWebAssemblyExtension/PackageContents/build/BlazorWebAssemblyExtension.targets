<Project>

  <Target Name="BzExDevSvr_BlazorWebAssemblyExtension_PrepareResponseFile" BeforeTargets="BzExDevSvr_GenerateResponseFile">
    <ItemGroup>
      <BzExDevSvrAssembly Include="BlazorWebAssemblyExtension" />
      <BzExDevSvrDeps Include="$(MSBuildThisFileDirectory)../tools/net10.0/BlazorWebAssemblyExtension.deps.json" />
      <!--
      <BzExDevSvrEnvValue Include="NAME1=value1" />
      <BzExDevSvrEnvValue Include="NAME2=value2" />
      -->
    </ItemGroup>
  </Target>

</Project>