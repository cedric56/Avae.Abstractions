<uxd:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="Avae.Abstractions.AvaePopupPage"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Avae.ViewModels;assembly=Avae.ViewModels"
    xmlns:local="Avae.Abstractions"
    xmlns:uxd="clr-namespace:UXDivers.Popups.Maui;assembly=UXDivers.Popups.Maui"
    xmlns:uxdc="clr-namespace:UXDivers.Popups.Maui.Controls;assembly=UXDivers.Popups.Maui"
    
    >
  <!--PopupBackground="{DynamicResource BackgroundSecondaryColor}"
  PopupCornerRadius="{DynamicResource CornerRadiusXBig}"-->
  <!--AppearingAnimation="{uxd:MoveInPopupAnimation MoveDirection=Right, Easing=SpringOut, Duration=400}"
    DisappearingAnimation="{uxd:StoryboardAnimation 
        Strategy=RunAllSequentially,       
        Animation1={uxd:ScaleToPopupAnimation Scale=1.2, Easing=Linear, Duration=150},   
        Animation2={uxd:ScaleToPopupAnimation Scale=0.5, Easing=Linear, Duration=150},              
        Animation3={uxd:MoveOutPopupAnimation MoveDirection=Left, Easing=SpringOut, Duration=500}}"-->
  <uxd:PopupPage.Resources>

    <!-- ============ iOS / MacCatalyst — UIAlertController style ============ -->
    <!-- Rounded 14, centered bold title, hairline divider above AND between buttons -->
    <ControlTemplate x:Key="iOSTemplate">
      <Grid
          WidthRequest="{OnIdiom Default=270, Tablet=320, Desktop=320}"
          VerticalOptions="Center"
          RowDefinitions="Auto,Auto,1,Auto">

        <Border
            Grid.RowSpan="4"
            BackgroundColor="{Binding PopupBackground, Source={RelativeSource TemplatedParent}}"
            Stroke="Transparent">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="14" />
          </Border.StrokeShape>
        </Border>

        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="16,20,16,4">
          <Label
              Text="{Binding Title, Source={RelativeSource TemplatedParent}}"
              FontSize="17"
              FontAttributes="Bold"
              HorizontalTextAlignment="Center"
              TextColor="{DynamicResource TextColor}" />
        </VerticalStackLayout>

        <ContentPresenter Grid.Row="1" Padding="16,0,16,20" />

        <!-- hairline above button row -->
        <BoxView Grid.Row="2" HeightRequest="1" Color="{DynamicResource PopupBorderColor}" />

        <!-- equal-width buttons separated by hairlines, text-only iOS blue -->
        <Grid Grid.Row="3"
              ColumnDefinitions="{Binding Definitions, Source={RelativeSource TemplatedParent}}"
              ColumnSpacing="1"
              HeightRequest="44"
              BackgroundColor="{DynamicResource PopupBorderColor}">
          <BindableLayout.ItemsSource>
            <Binding Path="Commands" Source="{RelativeSource TemplatedParent}" />
          </BindableLayout.ItemsSource>
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Button
                  Text="{Binding Name}"
                  Command="{Binding Command}"
                  Grid.Column="{Binding Index}"
                  BackgroundColor="{DynamicResource BackgroundSecondaryColor}"
                  TextColor="#007AFF"
                  FontAttributes="{Binding IsPrimary, Converter={StaticResource BoolToFontAttrConverter}}"
                  CornerRadius="0"
                  BorderWidth="0"
                  HorizontalOptions="Fill" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </Grid>
      </Grid>
    </ControlTemplate>

    <!-- ============ Android — Material 3 dialog style ============ -->
    <!-- Rounded 28, left-aligned title, elevated shadow, right-aligned flat text buttons, NO divider -->
    <ControlTemplate x:Key="AndroidTemplate">
      <Grid
          WidthRequest="{OnIdiom Default=-1, Tablet=340, Desktop=340}"
          VerticalOptions="Center"
          Margin="{DynamicResource AirSpacing}"
          RowDefinitions="*,Auto"
          RowSpacing="{DynamicResource SpacingSmall}"
          Padding="24,20,24,8">

        <Border
            Grid.RowSpan="2"
            Margin="-24"
            BackgroundColor="{Binding PopupBackground, Source={RelativeSource TemplatedParent}}"
            Stroke="Transparent">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="28" />
          </Border.StrokeShape>
          <Border.Shadow>
            <Shadow Brush="#40000000" Offset="0,2" Radius="12" Opacity="0.3" />
          </Border.Shadow>
        </Border>

        <VerticalStackLayout Grid.Row="0" Spacing="8">
          <Label
              Text="{Binding Title, Source={RelativeSource TemplatedParent}}"
              FontSize="24"
              FontAttributes="Bold"
              HorizontalOptions="Start"
              TextColor="{DynamicResource TextColor}" />
          <ContentPresenter HorizontalOptions="Fill" VerticalOptions="Fill" />
        </VerticalStackLayout>

        <!-- flat text buttons, right-aligned, no divider -->
        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="End" Spacing="8" Margin="0,4,0,4">
          <BindableLayout.ItemsSource>
            <Binding Path="Commands" Source="{RelativeSource TemplatedParent}" />
          </BindableLayout.ItemsSource>
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Button
                  Text="{Binding Name}"
                  Command="{Binding Command}"
                  BackgroundColor="Transparent"
                  TextColor="{DynamicResource PrimaryColor}"
                  FontAttributes="None"
                  CornerRadius="20"
                  Padding="12,0"
                  BorderWidth="0" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
      </Grid>
    </ControlTemplate>

    <!-- ============ Windows — WinUI ContentDialog style ============ -->
    <ControlTemplate x:Key="WindowsTemplate">
      <Grid
          WidthRequest="{OnIdiom Default=-1, Tablet=380, Desktop=380}"
          VerticalOptions="Center"
          RowDefinitions="Auto,Auto,Auto">

        <Border
            Grid.RowSpan="3"
            BackgroundColor="{DynamicResource BackgroundSecondaryColor}"
            Stroke="{DynamicResource PopupBorderColor}"
            StrokeThickness="1">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
            <!--{Binding PopupBackground, Source={RelativeSource TemplatedParent}}"-->
          </Border.StrokeShape>
          <Border.Shadow>
            <Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.2" />
          </Border.Shadow>
        </Border>

        <Label
            Grid.Row="0"
            Text="{Binding Title, Source={RelativeSource TemplatedParent}}"
            FontSize="20"
            FontAttributes="Bold"
            Padding="24,24,24,0"
            TextColor="{DynamicResource TextColor}" />

        <ContentPresenter Grid.Row="1" Padding="24,12,24,24" />

        <!-- Button row: inset padding, rounded buttons, gap between them, no divider line -->
        <Grid Grid.Row="2"
              ColumnDefinitions="{Binding Definitions, Source={RelativeSource TemplatedParent}}"
              ColumnSpacing="2"
              HeightRequest="44">
          <BindableLayout.ItemsSource>
            <Binding Path="Commands" Source="{RelativeSource TemplatedParent}" />
          </BindableLayout.ItemsSource>
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Button
                  Text="{Binding Name}"
                  Command="{Binding Command}"
                  Grid.Column="{Binding Index}"
                  BackgroundColor="{Binding IsPrimary, Converter={StaticResource BoolToAccentOrNeutralConverter}}"
                  TextColor="{Binding IsPrimary, Converter={StaticResource BoolToWhiteOrTextColorConverter}}"
                  CornerRadius="4"
                  BorderWidth="0"
                  Padding="0"
                  FontSize="14"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </Grid>
      </Grid>
    </ControlTemplate>

  </uxd:PopupPage.Resources>
</uxd:PopupPage>