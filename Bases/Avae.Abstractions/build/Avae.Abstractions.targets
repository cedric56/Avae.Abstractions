<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <ItemGroup Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true'">
      <PackageReference Update="Microsoft.AspNetCore.Components.Web" />
      <PackageReference Include="MudBlazor" />
      <Compile Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Razor\**\*.cs"/>
      <RazorComponent Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Components\**\*.css">
        <Link>Components\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <TargetPath>Components\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        <CssScope></CssScope>
      </RazorComponent>
      <Content Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Components\**\*.razor">
        <Link>Components\%(RecursiveDir)%(Filename)%(Extension)</Link>
      </Content>
  </ItemGroup>

    <ItemGroup Condition="'$(UseMaui)' == 'true' AND '$(UsingMicrosoftNETSdkRazor)' != 'true'">
      <PackageReference Include="UXDivers.Popups.Maui" />
      <PackageReference Update="Microsoft.Maui.Controls" />
      <Compile Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Maui\**\*.cs" />
      <MauiXaml Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Maui\**\*.xaml">
        <Generator>MSBuild:Compile</Generator>
      </MauiXaml>
    </ItemGroup>

    <ItemGroup Condition="'$(UseMaui)' == '' AND '$(UsingMicrosoftNETSdkRazor)' != 'true'">
      <PackageReference Update="Avalonia" />
      <PackageReference Include="MessageBox.Avalonia" />
      <PackageReference Include="FluentAvaloniaUI" />
      <Compile Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Avalonia\**\*.cs" />
      <AvaloniaResource Include="$(MSBuildThisFileDirectory)..\lib\net10.0\Avalonia\**\*.axaml" />
    </ItemGroup>

</Project>