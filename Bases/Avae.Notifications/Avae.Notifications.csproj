<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-android;net11.0-ios;net11.0-maccatalyst;net11.0-macos;net11.0-browser</TargetFrameworks>
    <TargetFrameworks>$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <StaticWebAssetsEnabled Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-browser'))">false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.JSInterop" />
    <PackageReference Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))" Include="Avalonia.Desktop" />
    <PackageReference Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-macos'))" Include="Avalonia.Desktop" />
    <PackageReference Condition="'$(TargetFramework)' == 'net11.0'" Include="Avalonia.Desktop" />
    <PackageReference Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios'))" Include="Avalonia.iOS" />
    <PackageReference Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-maccatalyst'))" Include="Avalonia.iOS" />
    <PackageReference Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android'))" Include="Avalonia.Android" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Avae.Services\Avae.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Labs.Notifications" />
  </ItemGroup>

</Project>