<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- This is the value you want to send to A -->
    <MyPropertyFromB>HelloFromB</MyPropertyFromB>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />    
  </ItemGroup>

  <ItemGroup>
    <AdditionalTargetFrameworkInfoProperty Include="MyPropertyFromB" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Example.Razor\Example.Razor.csproj" />
    
  </ItemGroup>

</Project>
