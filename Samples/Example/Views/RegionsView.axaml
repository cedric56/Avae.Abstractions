<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Example.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Example.RegionsView"
             x:DataType="{x:Type vm:RegionsViewModel}">
  <Grid RowDefinitions="*,*">
    <StackPanel Grid.Row="0" >
      <ContentControl Content="{Binding MainView}" />
      <StackPanel Orientation="Horizontal">
        <Button Content="Back" Command="{Binding Back}"/>
        <Button Content="Next" Command="{Binding Next}"/>
      </StackPanel>
    </StackPanel>
    <ContentControl Grid.Row="1" Content="{Binding SideView}" />
  </Grid>
</UserControl>
