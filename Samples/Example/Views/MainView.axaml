<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Example.ViewModels"
			 xmlns:behavior="using:Example"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Example.Views.MainView"
             x:DataType="vm:MainViewModel">
	<!--xmlns:i="https://github.com/projektanker/icons.avalonia"-->
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

	<DrawerPage Content="{Binding CurrentView}"
			 Header="Application">
		 <DrawerPage.Drawer>
			<StackPanel Spacing="5" Margin="5">
				<ListBox
					x:Name="MenuItemsListBox"
					ItemsSource="{Binding Navigables}"
					SelectedItem="{Binding SelectedNavigable}">
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="10" />
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel
								Spacing="10"
								Orientation="Horizontal">
								<ContentControl Content="{Binding Icon}"/>
								<TextBlock Text="{Binding DisplayName}" />
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</DrawerPage.Drawer>
	</DrawerPage>
	<!--<DockPanel Background="{DynamicResource DrawerBackground}">
    <Border DockPanel.Dock="Top" Margin="5"
            >
        <DockPanel>
            <ToggleButton DockPanel.Dock="Left"
                          IsChecked="{Binding #MyDrawerPage.IsPaneOpen, Mode=TwoWay}"
