                <PathIcon Data="{DynamicResource DrawerPaneButtonIcon}"/>
            </ToggleButton>
            <TextBlock Text="Application" Margin="10,0,0,0"
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold" />
