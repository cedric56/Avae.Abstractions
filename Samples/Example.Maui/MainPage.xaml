<local:FlyoutEx xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Example.Maui.MainPage"
                xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
            Title="Home"
            xmlns:local="clr-namespace:Example.Maui"
            CurrentPage="{Binding CurrentView}">
    <local:FlyoutEx.Flyout>
        <ContentPage Title="Menu">
            <CollectionView Grid.Row="1"
				ItemsSource="{Binding Navigables}"
				SelectionMode="Single"
				SelectedItem="{Binding SelectedNavigable}"
				BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout>
                            <Label 
                            Text="{Binding DisplayName}"
							FontSize="16"
							TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ContentPage>
    </local:FlyoutEx.Flyout>
</local:FlyoutEx>
