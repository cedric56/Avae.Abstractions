<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Example.Maui.Views.MenuView"
    xmlns:abstractions="using:Avae.Maui">
    <ContentView.Resources>
        <ResourceDictionary>
            <abstractions:NullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid RowDefinitions="*">
        <ContentView Content="{Binding CurrentView}"
                               HorizontalOptions="Fill"
VerticalOptions="Fill"/>
        <Grid RowDefinitions="Auto,*"
          HorizontalOptions="Fill"
VerticalOptions="Fill" IsVisible="{Binding CurrentView, Converter={StaticResource IsNullConverter}}">
            <Grid Grid.Row="0" HorizontalOptions="End">
                <Label Text="{Binding Title}" />
                <Grid ColumnDefinitions="Auto,Auto,Auto" >
                    <Button Text="Add" Command="{Binding AddCommand}"/>
                    <Button Text="Update" Command="{Binding UpdateCommand}" Grid.Column="1"/>
                    <Button Text="Remove" Command="{Binding RemoveCommand}" Grid.Column="2"/>
                </Grid>
            </Grid>
            <CollectionView ItemsSource="{Binding Persons}" SelectedItem="{Binding SelectedPerson}"
                    SelectionMode="Single"                    
                    Grid.Row="1"
                            Margin="20">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Orientation="Horizontal">
                            <Label Text="{Binding FirstName}" />
                            <Label Text="{Binding LastName}" Margin="10,0,0,0"/>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentView>
