<ContentView x:Class="Example.Maui.Views.ModalView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:abstractions="clr-namespace:Avae.Maui;assembly=Avae.Maui"
             xmlns:current="clr-namespace:Example.Maui.Views"
>
    <abstractions:AvaeEntry 
        ColumnName="Message"
        Text="{Binding Message}"
        UnderlineColor="Red"
        UnderlineThickness="5"
        HorizontalOptions="Fill" VerticalOptions="Fill"
        />
</ContentView>
