<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Example.Maui.Views.HomeView">
    <VerticalStackLayout>
        <Button 
            Text="Welcome to .NET MAUI!"
            Command="{Binding ShowModalCommand}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button 
            Text="Show Task Dialog"
            Command="{Binding ShowTaskDialogCommand}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button
            Text="Show Content Dialog"
            Command="{Binding ShowContentDialogCommand}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Button Text="Notification" Command="{Binding ShowNotificationCommand}" 
                VerticalOptions="Center"
HorizontalOptions="Center" />
        <Button Text="System" Command="{Binding ShowSystemNotificationCommand}" 
                VerticalOptions="Center"
HorizontalOptions="Center" />
        <Button Text="Theme" Command="{Binding ShowRequestedThemeCommand}" 
                VerticalOptions="Center"
HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>