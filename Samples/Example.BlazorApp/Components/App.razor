@using Avae.DAL
@using Example.DAL
@using Example.Models
@using Example.Razor.Layout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Maui.Storage
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IDBMonitor<Person> monitor;
@inject IJSRuntime runtime;
@inject IServiceProvider provider;
@* @inject VideoCaptureCoordinator Coordinator *@
@implements IAsyncDisposable
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* <ResourcePreloader @rendermode="InteractiveWebAssembly" />*@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Example.BlazorApp.styles.css"]" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    @* <link href="@Assets["_content/Avae.Razor/theme.css"]" rel="stylesheet" /> *@
    @* <ImportMap @rendermode="InteractiveWebAssembly" /> *@
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @if (_visible)
    { 
        @* <VideoCaptureDialog OnCompleted="HandleCompleted" /> *@
    }
    <Routes @rendermode="InteractiveServer" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Avae.BlazorEssentials/js/interop.js"></script>
    <script src="_content/Avae.Browser/avae_browser.js"></script>
    <script>
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register(
                    "_content/Avae.Blazor.Notifications/service-worker.js"
                    ,
                    { scope: "/" }
                );
            }
    </script>
</body>
</html>

@code
{    
    Func<Task>? unsuscribe;

    protected override async Task OnInitializedAsync()
    {
        unsuscribe = await provider.AddStreamingHub(monitor);        
        //Coordinator.RequestCapture += OnRequestCapture;
        await base.OnInitializedAsync();
    }

    private bool _visible;
    private TaskCompletionSource<FileResult?>? _tcs;

    private async Task OnRequestCapture(TaskCompletionSource<FileResult?> tcs)
    {
        _tcs = tcs;
        await InvokeAsync(async () =>
        {
            _visible = true;
            StateHasChanged();
            await Task.Yield();
        });
        await Task.Yield();
    }

    protected override bool ShouldRender()
    {
        return base.ShouldRender();
    }

    private async void HandleCompleted(FileResult? result)
    {
        await InvokeAsync(() =>
        {
            _visible = false;
            _tcs?.TrySetResult(result);
            _tcs = null;
            StateHasChanged();
        });
    }

    ValueTask IAsyncDisposable.DisposeAsync()
    {
        //Coordinator.RequestCapture -= OnRequestCapture;
        return ValueTask.CompletedTask;
    }
}