@using System.ComponentModel
@using Avae.Razor
@using Avae.ViewModels
@using Example.Models
@using Example.ViewModels
@using MudBlazor
@inherits Avae.Razor.Components.AvaeComponentBase<MenuViewModel>
@implements IAsyncDisposable
@page "/menu"
@if (CurrentView != null)
{
    <DynamicComponent Type="@CurrentView.Type" Parameters="@CurrentView.Parameters"/>
}
else if(ViewModel != null)
{
    <MudButton OnClick="ViewModel.Add">Add</MudButton>
    <MudButton OnClick="ViewModel.Update" Disabled="@IsDisabled">Update</MudButton>
    <MudButton OnClick="ViewModel.Remove" Disabled="@IsDisabled">Remove</MudButton>

    <MudList T="Person" 
        @bind-SelectedValue="@ViewModel.SelectedPerson"
        SelectionMode="SelectionMode.SingleSelection" >
        @foreach (var p in ViewModel.Persons)
        {
            <MudListItem Text="@p.FullName" Value="@p" />
        }
    </MudList>
}

@code {

    private bool IsDisabled => ViewModel?.SelectedPerson == null;

    private ViewFor? CurrentView => ViewModel?.CurrentView as ViewFor;

    protected override void OnParametersSet()
    {
        ViewModel.PropertyChanged -= ViewModel_PropertyChanged;
        ViewModel.PropertyChanged += ViewModel_PropertyChanged;

        base.OnParametersSet();
    }

    private async void ViewModel_PropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(MenuViewModel.CurrentView))
            await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        ViewModel.PropertyChanged -= ViewModel_PropertyChanged;
        return ValueTask.CompletedTask;
    }
}