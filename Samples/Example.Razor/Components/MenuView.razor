@using Avae.Razor
@using Avae.ViewModels
@using Example.Models
@using Example.ViewModels
@using MudBlazor
@inherits AvaeComponentBase<MenuViewModel>
@implements IAsyncDisposable
@page "/menu"
@if (ViewModel.CurrentView is ViewFor viewFor)
{
    @viewFor.Content
}
else if(ViewModel != null)
{
    <MudButton OnClick="ViewModel.Add">Add</MudButton>
    <MudButton OnClick="ViewModel.Update" Disabled="@IsDisabled">Update</MudButton>
    <MudButton OnClick="ViewModel.Remove" Disabled="@IsDisabled">Remove</MudButton>

    <MudList T="Person" 
        @bind-SelectedValue="@ViewModel.SelectedPerson"
        SelectionMode="SelectionMode.SingleSelection" >
        @foreach (var p in ViewModel.Persons)
        {
            <MudListItem Text="@p.FullName" Value="@p" />
        }
    </MudList>
}

@code {

    private bool IsDisabled => ViewModel?.SelectedPerson == null;

    protected override void OnParametersSet()
    {
        ViewModel.CurrentViewChanged -= CurrentViewChanged;
        ViewModel.CurrentViewChanged += CurrentViewChanged;

        base.OnParametersSet();
    }

    private async void CurrentViewChanged(object? sender, IViewFor? e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        ViewModel.CurrentViewChanged -= CurrentViewChanged;
        return ValueTask.CompletedTask;
    }
}