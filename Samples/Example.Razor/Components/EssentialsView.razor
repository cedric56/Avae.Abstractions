@page "/essentials"
@inherits AvaeComponentBase<EssentialsViewModel>
@using Avae.Razor
@using Example.ViewModels
@using MudBlazor

<MudExpansionPanels MultiExpansion="true">
    <MudExpansionPanel Text="Dialogs">
        <MudButton OnClick="() => ViewModel.PickPhotoCmd()">Pick a Photo</MudButton>
        <MudButton OnClick="() => ViewModel.PickVideoCmd()">Pick a Video</MudButton>
        <MudButton OnClick="() => ViewModel.PickFileCmd()">File</MudButton>
        <MudButton Disabled="@ViewModel.IsSupportedInMauiPlatformInverted()" OnClick="() => ViewModel.PickImageCmd()">Image</MudButton>
        <MudButton Disabled="@ViewModel.IsSupportedInMauiPlatformInverted()" OnClick="() => ViewModel.PickPdfCmd()">Pdf</MudButton>
        <MudButton OnClick="() => ViewModel.PickCustomTypeCmd()">Custom</MudButton>
        <MudButton OnClick="() => ViewModel.PickMultipleFilesCmd()">Multiple</MudButton>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Medias">
        <MudButton OnClick="() => ViewModel.DialCmd()">Dial</MudButton>
        <MudButton OnClick="() => ViewModel.SmsCmdAsync()">Sms</MudButton>
        <MudButton OnClick="() => ViewModel.ContactsCmd()">Contacts</MudButton>
        <MudButton OnClick="() => ViewModel.EmailCmd()">Email</MudButton>
        <MudButton OnClick="() => ViewModel.ShareCmdAsync()">Share</MudButton>
        <MudButton OnClick="() => ViewModel.CapturePhotoCmd()">CapturePhoto</MudButton>
        <MudButton OnClick="() => ViewModel.CaptureVideoCmd()">CaptureVideo</MudButton>
        <MudButton OnClick="() => ViewModel.ScreenshotCmd()">Screenshot</MudButton>
        <MudButton OnClick="() => ViewModel.BrowserCmdAsync()">Browser</MudButton>
        <MudButton OnClick="() => ViewModel.MapCmdAsync()">Map</MudButton>
        <MudButton OnClick="() => ViewModel.LaunchCmd()">Launch</MudButton>
        <MudButton OnClick="() => ViewModel.AppInfoCmd()">AppInfo</MudButton>
        <MudButton OnClick="() => ViewModel.DeviceDisplayCmd()">DeviceInfo</MudButton>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Sensors">
        <MudButton OnClick="() => ViewModel.AccelerometerCmd()">Accelerometer</MudButton>
        <MudButton OnClick="() => ViewModel.MagnetometerCmd()">Magnetometer</MudButton>
        <MudButton OnClick="() => ViewModel.BarometerCmd()">Barometer</MudButton>
        <MudButton OnClick="() => ViewModel.OrientationSensorCmd()">OrientationSensor</MudButton>
        <MudButton OnClick="() => ViewModel.VibrationCmdAsync()">Vibration</MudButton>
        <MudButton OnClick="() => ViewModel.CompassCmdAsync()">Compass</MudButton>
        <MudButton OnClick="() => ViewModel.GyroscopeCmd()">Gyroscope</MudButton>
        <MudButton OnClick="() => ViewModel.FlashOnCmd()">Flash On</MudButton>
        <MudButton OnClick="() => ViewModel.FlashOffCmd()">Flash Off</MudButton>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Others">
        <MudButton OnClick="() => ViewModel.ConnectivityCmdAsync()">Connectivity</MudButton>
        <MudButton OnClick="() => ViewModel.VersionCmd()">Version</MudButton>
        <MudButton OnClick="() => ViewModel.SpeechCmdAsync()">Speech</MudButton>
        <MudButton OnClick="() => ViewModel.BatteryCmd()">Battery</MudButton>
        <MudButton OnClick="() => ViewModel.DeviceDisplayCmd()">DeviceDisplay</MudButton>
        <MudButton OnClick="() => ViewModel.SecureStorageCmd()">SecureStorage</MudButton>
        <MudButton OnClick="() => ViewModel.FileSystemCmd()">FileSystem</MudButton>
        <MudButton OnClick="() => ViewModel.HapticCmd()">Haptic</MudButton>
        <MudButton OnClick="() => ViewModel.SemanticCmd()">Semantic</MudButton>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Geo">
        <MudButton OnClick="() => ViewModel.GeocodeCmd()">Geocode</MudButton>
        <MudButton OnClick="() => ViewModel.GeolocationCmd()">Geolocation</MudButton>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Authentification">
        <MudButton OnClick="() => ViewModel.GoogleCmd()">Google</MudButton>
        <MudText>Auth token :</MudText> 
        <MudText>@ViewModel.AuthToken</MudText>
    </MudExpansionPanel>
</MudExpansionPanels>
