@page "/"
@inherits Avae.Razor.Components.AvaeComponentBase
@using Avae.ViewModels
@using Avae.Services
@using Example.ViewModels
@using Microsoft.AspNetCore.Components.Web
@inject ISystemNotificationService service;
@using MudBlazor

@inject IServiceProvider provider

<style>
    .rows
    {
        display:grid;
        grid-template-rows:auto auto auto auto auto
    }
</style>

<PageTitle>Home</PageTitle>

<div class="rows center">
    <MudButton OnClick="() => HomeViewModel.ShowModal()">Show Modal</MudButton>
    <MudButton OnClick="() => HomeViewModel.ShowContentDialog()">Show ContentDialog</MudButton>
    <MudButton OnClick="() => HomeViewModel.ShowTaskDialog()">Show TaskDialog</MudButton>
    <MudButton OnClick="() => HomeViewModel.ShowNotification()">Show Snack</MudButton>
    <MudButton OnClick="() => HomeViewModel.ShowRequestedTheme()">Theme</MudButton>
    <MudButton OnClick="() => HomeViewModel.ShowSystemNotification()">Notification</MudButton>
</div>

@code
{
    HomeViewModel HomeViewModel => provider.GetViewModel<HomeViewModel>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await service.InitializeAsync();
        await base.OnAfterRenderAsync(firstRender);
    }
}