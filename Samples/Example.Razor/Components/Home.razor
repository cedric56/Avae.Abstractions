@using Avae.Razor
@using Avae.Services
@using CommunityToolkit.Mvvm.Messaging
@using Example.ViewModels
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using MudBlazor
@inherits AvaeComponentBase<HomeViewModel>
@page "/"
@inject Avae.Services.IDialogService dialogService
<style>
    .rows
    {
        display:grid;
        grid-template-rows:auto auto auto auto auto
    }
</style>

<PageTitle>Home</PageTitle>

<div class="rows center">
    <MudButton OnClick="() => ViewModel.ShowModal()">Show Modal</MudButton>
    <MudButton OnClick="() => ViewModel.ShowContentDialog()">Show ContentDialog</MudButton>
    <MudButton OnClick="() => ViewModel.ShowTaskDialog()">Show TaskDialog</MudButton>
    <MudButton OnClick="() => ViewModel.ShowNotification()">Show Snack</MudButton>
    <MudButton OnClick="() => ViewModel.ShowRequestedTheme()">Theme</MudButton>
    <MudButton OnClick="() => ViewModel.ShowSystemNotification()">Notification</MudButton>
    <MudButton OnClick="() => ViewModel.Messenger()">Messenger</MudButton>
    <MudButton OnClick="() => ViewModel.Environment()">Environment</MudButton>
</div>


@code
{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var service = Provider.GetService<ISystemNotificationService>();
            if (service != null)
                await service.InitializeAsync();

            WeakReferenceMessenger.Default.Register<string, HomeViewModel>(
                this, ViewModel, async (o, s) =>
                {
                    await dialogService.ShowOkAsync(s, "Message from HomeViewModel");
                });
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}