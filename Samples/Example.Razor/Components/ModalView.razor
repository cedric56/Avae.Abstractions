@inherits AvaeComponentBase<ModalViewModel>
@using Avae.Razor
@using Avae.Services
@using Example.ViewModels
@using MudBlazor
@inject IRequestedThemeService themeService
<MudDialog Class="@($"wui-dialog {(Service.IsDarkMode ? "mud-theme-dark" : "")}")">
    <TitleContent>
        <h6>@ViewModel.Title</h6>
        @* <MudTextField T="string" Typo="Typo.h6" @bind-Value="ViewModel.Title"/> *@
    </TitleContent>

    <DialogContent>
        <MudTextField label="Message" @bind-Value="ViewModel.Message" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" onclick="@(() => ViewModel.Validate())">Validate</MudButton>
        <MudButton onclick="@(() => ViewModel.Cancel())">Cancel</MudButton>
    </DialogActions>
</MudDialog>
@code {
    private RequestThemeService Service => (RequestThemeService)themeService;
}