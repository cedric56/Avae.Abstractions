@using Avae.DAL
@using Example.DAL
@using Example.Models
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Maui.Storage
@inject IServiceProvider provider;
@inject IDBMonitor<Person> monitor;
@* @inject IVideoCaptureHandles handles *@
@implements IAsyncDisposable

<Router AppAssembly="typeof(Example.Razor.Components.Home).Assembly"
        AdditionalAssemblies="new[] { typeof(Avae.Razor.Layout.MainLayout).Assembly }"
        NotFoundPage="typeof(Avae.Razor.Components.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Avae.Razor.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
@if (isVisible)
{
    @* @handles?.VideoFragment; *@
}

@code
{
    Func<Task>? unsuscribe;
    bool isVisible = false;

    protected override async Task OnInitializedAsync()
    {
        // if (handles != null)
        //     handles.RequestCapture += OnRequestCapture;
        if (OperatingSystem.IsBrowser())
            unsuscribe = await provider.AddStreamingHub(monitor);
        //unsuscribe = await provider.AddSignalR(monitor);

        await base.OnInitializedAsync();
    }
    
    TaskCompletionSource<FileResult?>? _tcs;    
    private async Task OnRequestCapture(TaskCompletionSource<FileResult?> tcs)
    {
        _tcs = tcs;
        await InvokeAsync(async () =>
        {
            isVisible = true;
            StateHasChanged();
        });
    }

    private async void HandleCompleted(FileResult? result)
    {
        await InvokeAsync(() =>
        {
            isVisible = true;
            _tcs?.TrySetResult(result);
            _tcs = null;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (unsuscribe != null)
            await unsuscribe();
    }
}

