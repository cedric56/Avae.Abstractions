@using Avae.DAL
@using Example.DAL
@using Example.Models
@using Example.Razor.Layout
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IDBMonitor<Person> monitor;
@inject IServiceProvider provider;
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* <ResourcePreloader @rendermode="InteractiveWebAssembly" />*@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Example.BlazorApp.styles.css"]" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    @* <link href="@Assets["_content/Avae.Razor/theme.css"]" rel="stylesheet" /> *@
    @* <ImportMap @rendermode="InteractiveWebAssembly" /> *@
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <div id="app"></div>
    <Routes @rendermode="InteractiveServer" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    @* <script src="_framework/blazor.server.js"></script>*@
    @* <script src="_framework/dotnet.js"></script> *@
</body>

</html>

@code
{
    Func<Task>? unsuscribe;

    protected override async Task OnInitializedAsync()
    {
        unsuscribe = await provider.AddStreamingHub(monitor);
        await base.OnInitializedAsync();
    }
}
