<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AvaloniaNightly"
         value="https://nuget-feed-all.avaloniaui.net/v3/index.json" />
    <!-- adapte l’URL si ta source Nightly est différente -->
  </packageSources>

  <packageSourceMapping>
    <!-- Tout le reste depuis nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>

    <!-- Uniquement les packages Avalonia depuis Nightly -->
    <packageSource key="AvaloniaNightly">
      <package pattern="Avalonia*" />
      <package pattern="MicroCom*" />
      <!-- ajoute d’autres patterns si besoin (ex. Tizen, etc.) -->
    </packageSource>
  </packageSourceMapping>
</configuration>